	},
	"peerDependencies": {
		"typescript": "^5.9.2"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.14",
		"@tanstack/react-router": "^1.132.7",
		"@tanstack/react-start": "^1.132.15",
		"@vitejs/plugin-react": "^5.0.4",
		"clsx": "^2.1.1",
		"dotenv": "^17.2.3",
		"drizzle-orm": "^0.44.5",
		"drizzle-seed": "^0.3.1",
		"pg": "^8.16.3",
		"radix-ui": "^1.4.3",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"tailwind-merge": "^3.3.1",
