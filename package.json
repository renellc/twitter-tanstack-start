{
	"$schema": "https://www.schemastore.org/package.json",
	"name": "twitter-tanstack-start",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bunx --bun vite",
		"build": "vite build",
		"check": "bunx biome check --write",
